{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/rsvp.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:fn/",
      "destination": "/api/:fn"
    },
    {
      "source": "/aldar-openhouse/api/:fn/",
      "destination": "/api/:fn"
    },
    {
      "source": "/aldar-openhouse/api/:fn",
      "destination": "/api/:fn"
    },
    {
      "source": "/aldar-openhouse",
      "destination": "/"
    },
    {
      "source": "/aldar-openhouse/",
      "destination": "/"
    },
    {
      "source": "/aldar-openhouse/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/aldar-openhouse/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/aldar-openhouse/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
